    "**/._.DS_Store": true,

    // Windows
    "**/Thumbs.db": true,

    // Version Control Systems
    "**/.git/*": true,  // Git
    "**/.hg/*": true,   // Mercurial
    "**/.svn/*": true,  // Subversion
  },
  "files.insertFinalNewline": true,
  "files.trimTrailingWhitespace": true,

  // NOTE:
  //   https://github.com/microsoft/vscode/issues/134415
  //   https://github.com/microsoft/vscode/blob/e80a0ca648fe9bef07070e4f7fb04e67f2243252/src/vs/base/common/glob.ts#L464-L472
  /**
  * Simplified glob matching. Supports a subset of glob patterns:
  * * `*` to match one or more characters in a path segment
  * * `?` to match on one character in a path segment
  * * `**` to match any number of path segments, including none
  * * `{}` to group conditions (e.g. *.{ts,js} matches all TypeScript and JavaScript files)
  * * `[]` to declare a range of characters to match in a path segment (e.g., `example.[0-9]` to match on `example.0`, `example.1`, …)
  * * `[!...]` to negate a range of characters to match in a path segment (e.g., `example.[!0-9]` to match on `example.a`, `example.b`, but not `example.0`)
  */
  "files.watcherExclude": {
    // "search.exclude" と共通 (ファイル)
    "**/.bash_history": true,
    "**/.python_history": true,
    "**/*.code-search": true,

    // "search.exclude" と共通 (ディレクトリ)
    "**/__pycache__/**": true,
    "**/.aws/**": true,
    "**/.aws-sam/**": true,
    "**/.cache/**": true,
    "**/.cargo/**": true,
    "**/.codex/**": true,
    "**/.conda/**": true,
    "**/.docker/buildx/refs/**": true,
    "**/.git/{objects,rr-cache,subtree-cache}/**": true,
    "**/.hg/store/**": true,
    "**/.npm/**": true,
    "**/.pyenv/**": true,
    "**/.pytest_cache/**": true,
    "**/.ruff_cache/**": true,
    "**/.temp/**": true,
    "**/.tmp/**": true,
    "**/.trash/**": true,
    "**/.venv/**": true,
    "**/.vscode/{agent-plugins,extensions}/**": true,
    "**/.vscode-remote-containers/**": true,
    "**/.vscode-server/**": true,
    "**/!(.local)/bin/**": true,
    "**/AppData/{Local,LocalLow,Roaming}/**": true,
    "**/bower_components/**": true,
    "**/node_modules/**": true,
    "**/obj/**": true,
    "**/static/libs/cdn*/**": true,
    "**/tmp/**": true,
    "**/venv/**": true,

    // "search.exclude" と共通でない (ディレクトリ)
    "**/.ssh/**": true,
    "**/.vim/**": true,
  },

