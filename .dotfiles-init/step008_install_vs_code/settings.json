  "cSpell.blockCheckingWhenTextChunkSizeGreaterThan": 10000,
  "cSpell.caseSensitive": false,
  "cSpell.customDictionaries": {
    "project-words": {
      "name": "project-words",
      "path": "${workspaceRoot}/.vscode/project-words.md",
      "addWords": true,
    },
    "custom": true,
    "internal-terms": false,
  },
  "cSpell.diagnosticLevel": "Warning",
  "cSpell.enabled": true,
  "cSpell.ignorePaths": [
    // デフォルトをベースに改変
    "**/.git/{info,lfs,logs,refs,objects}/**",
    "**/.git/{index,*refs,*HEAD}",
    "**/.vscode-insiders/**",
    "**/node_modules/**",
    "**/package-lock.json",
    "**/vscode-extension/**",

    // 追加
    // "**/.env*",
    "**/uv.lock",
    // "**/devcontainer.json",
    // ".devcontainer/devcontainer.json",
    // ".devcontainer/**/devcontainer.json",
    "**/.vscode/extensions.json",
    // ".vscode/{extensions,settings}.json",
  ],
  "cSpell.ignoreRegExpList": [
    "パスワード\\s*:\\s*['\"`][^'\"`]*['\"`]",
    // "/(pass|key)\\s*=\\s*[^\\s]*(\\s|$)/g",

    "/\\$6\\$(?:rounds=[1-9][0-9]{3,8}\\$)?[./0-9A-Za-z]{1,16}\\$[./0-9A-Za-z]{86}/g",

    // [Linux 関連]
    // ls -l の結果
    "(?<!\\S)[-bcCdDlMnPps?][r-][w-][xSs-][r-][w-][xSsLl-][r-][w-][xTt-](?:[+.?@])?(?=\\s|$)",

    // known_hosts
    "^\\|1\\|[0-9A-Za-z+/]{27}=\\|[0-9A-Za-z+/]{27}=\\s",
    "AAAAC3[0-9A-Za-z+/]{62}",                  // ホスト鍵 (ssh-rsa)
    // "AAAAC3[0-9A-Za-z+/]+={0,3}",
    "AAAAB3[0-9A-Za-z+/]{538}=",                // ホスト鍵 (ssh-ed25519)
    // "AAAAB3[0-9A-Za-z+/]+={0,3}",
    "AAAAE2[0-9A-Za-z+/]{134}=",                // ホスト鍵 (ecdsa-sha2-nistp256)
    // "AAAAE2[0-9A-Za-z+/]+={0,3}",

    "sk-(proj-)?[-_0-9a-zA-Z]{22,}",            // OpenAPI, LiteLLM 等のキー
    // "/sk-[^\\s]*(\\s|$)/g",

    // [AWS 関連]
    "\"A(ID|KI|RO|SI)A[0-9A-Z*]{16,18}[:\"]",   // IAM ユーザのアクセスキー
    "=\"Z[0-9A-Z]{13,32}\"",                    // Route 53 のホストゾーン ID
    "=\"fs-[0-9a-f]{17}\"",                     // EFS ファイルシステムの ID
    "=\"sg-[0-9a-f]{17}\"",                     // セキュリティグループの ID
    // Aurora の接続先ドメイン
    "['\"`][0-9a-zA-Z\\-]+-auroraserverlesscluster-[0-9a-z]+.cluster-[0-9a-z]+.ap-northeast-1.rds.amazonaws.com",

    // Tailscale / Headscale
    "[ht]skey-auth-[0-9A-Za-z_-]*",
  ],
  "cSpell.words": [
  ],

